# Copy to `.env.local` for development, or `/etc/99gold.env` on the VPS.
# Never commit real secrets.

SQLITE_PATH=./data/99gold.sqlite
# Public origin for cookies and absolute redirects behind nginx.
# Next.js request.url may be http://127.0.0.1:3000 even when Host is forwarded.
SITE_URL=https://99gold.net
ADMIN_EMAIL=stanleys1225@gmail.com
ADMIN_NAME=
# ADMIN_TOKEN=

# Optional. Better official-brief translations (zh-Hant / ja). Either key is accepted.
# OPENAI_API_KEY=
# TRANSLATE_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional self-hosted or public LibreTranslate. Without a key, MyMemory is the default MT.
# LIBRETRANSLATE_URL=
# LIBRETRANSLATE_API_KEY=
# MYMEMORY_EMAIL=

# Optional. Email / LINE price alerts. Browser notifications work without these.
# Set tokens once on the server. Destinations can also be saved in /admin.
# ALERT_EMAIL_TO=stanleys1225@gmail.com
# ALERT_EMAIL_FROM=99GOLD.NET <alerts@99gold.net>
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_USER_ID=
# LINE_NOTIFY_TOKEN=
# LINE_WEBHOOK_URL=
